# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=paytrack

# Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Admin credentials
ADMIN_EMAIL=admin@example.com
# Generate hash: node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(16).toString('hex');console.log(s+':'+scryptSync('your_password',s,64).toString('hex'))"
ADMIN_PASSWORD_HASH=<salt_hex>:<hash_hex>
